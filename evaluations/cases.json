  {
    "id": "21_segment_ratio",
    "task": "分别计算各渠道合计比例，保持总体和分组同口径。",
    "kind": "analysis",
    "data": [
      {
        "channel": "A",
        "orders": 50,
        "visits": 1000
      },
      {
        "channel": "A",
        "orders": 20,
        "visits": 100
      },
      {
        "channel": "B",
        "orders": 10,
        "visits": 100
      },
      {
        "channel": "B",
        "orders": 80,
        "visits": 1000
      }
    ],
    "metric": {
      "aggregation": "ratio",
      "column": "orders",
      "denominator": "visits",
      "unit": "percent"
    },
    "analysis": {
      "group": "channel"
    },
    "expected_tables": {
      "by_group": [
        [
          "A",
          0.06363636363636363,
          2
        ],
        [
          "B",
          0.08181818181818182,
          2
        ]
      ]
    },
    "expected": 0.07272727272727272
  },
