  {
    "id": "13_missing_month",
    "task": "一月和三月有数据，二月缺失不能填成零。",
    "kind": "analysis",
    "data": [
      {
        "date": "2025-01-01",
        "revenue": 10
      },
      {
        "date": "2025-03-01",
        "revenue": 20
      }
    ],
    "metric": {
      "aggregation": "sum",
      "column": "revenue"
    },
    "analysis": {
      "date": "date"
    },
    "expected_tables": {
      "by_period": [
        [
          "2025-01",
          10,
          1
        ],
        [
          "2025-02",
          null,
          0
        ],
        [
          "2025-03",
          20,
          1
        ]
      ]
    },
    "expected": 30
  },
  {
    "id": "14_business_timezone",
    "task": "北京时间月末汇总，不能按UTC日期错归到上月。",
    "kind": "analysis",
    "data": [
      {
        "date": "2025-01-31T20:00:00Z",
        "revenue": 10
      },
      {
        "date": "2025-02-01T01:00:00Z",
        "revenue": 20
      }
    ],
    "metric": {
      "aggregation": "sum",
      "column": "revenue"
    },
    "analysis": {
      "date": "date",
      "timezone": "Asia/Shanghai"
    },
    "expected_tables": {
      "by_period": [
        [
          "2025-02",
          30,
          2
        ]
      ]
    },
    "expected": 30
  },
