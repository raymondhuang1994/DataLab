  {
    "id": "08_valid_status",
    "task": "只统计有效订单的收入，取消订单不能进入指标。",
    "kind": "analysis",
    "data": [
      {
        "revenue": 10,
        "status": "valid"
      },
      {
        "revenue": 999,
        "status": "cancelled"
      }
    ],
    "metric": {
      "aggregation": "sum",
      "column": "revenue",
      "filters": [
        {
          "column": "status",
          "op": "eq",
          "value": "valid"
        }
      ]
    },
    "expected": 10
  },
  {
    "id": "09_null_filter",
    "task": "排除取消订单时，不应默默把未知状态当有效。",
    "kind": "analysis",
    "data": [
      {
        "revenue": 10,
        "status": "valid"
      },
      {
        "revenue": 999,
        "status": null
      },
      {
        "revenue": 8,
        "status": "cancelled"
      }
    ],
    "metric": {
      "aggregation": "sum",
      "column": "revenue",
      "filters": [
        {
          "column": "status",
          "op": "ne",
          "value": "cancelled"
        }
      ]
    },
    "expected": 10
  },
  {
    "id": "10_negative_denominator",
