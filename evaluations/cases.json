[
  {
    "id": "01_ratio_weighting",
    "task": "渠道访问量不同，求整体转化率，不要平均每期百分比。",
    "kind": "analysis",
    "data": [
      {
        "orders": 50,
        "visits": 1000
      },
      {
        "orders": 20,
        "visits": 100
      }
    ],
    "metric": {
      "aggregation": "ratio",
      "column": "orders",
      "denominator": "visits",
      "unit": "percent"
    },
    "expected": 0.06363636363636363
  },
  {
    "id": "02_zero_denominator",
    "task": "没有访问时，转化率是否可以记为零？",
    "kind": "analysis",
    "data": [
      {
        "orders": 0,
        "visits": 0
      }
    ],
    "metric": {
      "aggregation": "ratio",
      "column": "orders",
      "denominator": "visits",
      "unit": "percent"
    },
    "expected": null
  },
  {
    "id": "03_paired_missing",
    "task": "一行成交缺失，明确共同有效样本后计算比例。",
    "kind": "analysis",
    "data": [
      {
        "orders": 10,
        "visits": 100
      },
      {
        "orders": null,
        "visits": 900
      }
    ],
    "metric": {
      "aggregation": "ratio",
      "column": "orders",
      "denominator": "visits",
      "unit": "percent"
    },
    "expected": 0.1
  },
  {
    "id": "04_weighted_mean",
    "task": "按客户量合并两个群体的人均金额。",
